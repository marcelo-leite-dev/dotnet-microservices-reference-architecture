{
  "Service": {
    "Name": "catalog-api"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CatalogDb": "",
    "Redis": ""
  },
  "Kafka": {
    "BootstrapServers": "",
    "ConsumerGroup": "catalog-api",
    "ClientId": "catalog-api",
    "Topics": [ "catalog.products", "catalog.stock-reservations" ]
  },
  "Outbox": {
    "PollingInterval": "00:00:01",
    "BatchSize": 50
  },
  "Caching": {
    "Products": {
      "TimeToLive": "00:10:00"
    }
  },
  "Database": {
    "MigrateOnStartup": false
  }
}

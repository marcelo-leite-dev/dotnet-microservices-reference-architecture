{
  "Service": {
    "Name": "ordering-api"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "System.Net.Http": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrderingDb": ""
  },
  "Kafka": {
    "BootstrapServers": "",
    "ConsumerGroup": "ordering-api",
    "ClientId": "ordering-api",
    "Topics": [ "ordering.orders" ]
  },
  "Outbox": {
    "PollingInterval": "00:00:01",
    "BatchSize": 50
  },
  "Services": {
    "Catalog": {
      "BaseUrl": ""
    }
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
